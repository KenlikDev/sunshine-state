; Sunshine State — initial project configuration.
; CI and initial validation use Godot 4.7.2-stable. Update the CI pin and this note together.

config_version=5

[application]
config/name="Sunshine State"
config/description="Original single-player open-world action game. Foundation only; not a playable MVP."
run/main_scene="res://scenes/bootstrap/main.tscn"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
